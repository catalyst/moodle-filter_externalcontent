{{!
    @template filter_externalcontent/highlight_preview

    Live preview of what a highlight will look like when applied to a
    matching link. Rendered as a static row inside the highlight edit form
    (see classes/form/edit.php), right under the save/cancel buttons;

    Context variables required for this template:
    * wrapid - id for the outer wrapping element
    * labelid - id for the label element
    * labeltext - initial label text
    * labelstyle - initial CSS style for the label element
    * outlinestyle - initial CSS style for the wrapping element
    * linktext - sample link text
    * labelfieldid - id of the form's label text field to watch
    * backgroundfieldid - id of the form's background colour field to watch
    * textfieldid - id of the form's text colour field to watch

    Example context (json):
    {
        "wrapid": "filter-externalcontent-preview-wrap",
        "labelid": "filter-externalcontent-preview-label",
        "labeltext": "External",
        "labelstyle": "background-color:#f0ad4e;color:#ffffff;padding: 1px 4px 1px 2px;",
        "outlinestyle": "outline:2px solid #f0ad4e;padding-right:4px;",
        "linktext": "Example external link",
        "labelfieldid": "id_label",
        "backgroundfieldid": "id_backgroundcolour",
        "textfieldid": "id_textcolour"
    }
}}
<span id="{{wrapid}}" style="{{outlinestyle}}">
    <span id="{{labelid}}" class="filter-externalcontent-label" style="{{labelstyle}}">{{labeltext}}</span>
    <a href="#" onclick="return false;">{{linktext}}</a>
</span>
{{#js}}
require(['filter_externalcontent/highlight_preview'], function(Preview) {
    Preview.init({
        wrapId: '{{wrapid}}',
        labelId: '{{labelid}}',
        labelFieldId: '{{labelfieldid}}',
        backgroundFieldId: '{{backgroundfieldid}}',
        textFieldId: '{{textfieldid}}'
    });
});
{{/js}}
