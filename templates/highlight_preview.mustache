{{!
    @template filter_externalcontent/highlight_preview

    Live preview of what a highlight will look like when applied to a
    matching link. Rendered as a static row inside the highlight edit form
    (see classes/local/form/edit.php), right under the save/cancel buttons.

    Context variables:
    * defaultbackground - fallback background colour, must match
      \filter_externalcontent\highlight_renderer::DEFAULT_BACKGROUND_COLOUR
    * defaulttext - fallback text colour, must match
      \filter_externalcontent\highlight_renderer::DEFAULT_TEXT_COLOUR

    Example context (json):
    {
        "defaultbackground": "#f0ad4e",
        "defaulttext": "#ffffff"
    }
}}
<span id="filter-externalcontent-preview-{{uniqid}}" class="filter-externalcontent-preview">
    <span class="filter-externalcontent-label">
        {{#str}} preview_samplelabel, filter_externalcontent {{/str}}
    </span>
    <a href="#" onclick="return false;">{{#str}} preview_samplelink, filter_externalcontent {{/str}}</a>
</span>
{{#js}}
require(['filter_externalcontent/highlight_preview'], function(Preview) {
    Preview.init('filter-externalcontent-preview-{{uniqid}}', {
        defaultBackground: '{{defaultbackground}}',
        defaultText: '{{defaulttext}}'
    });
});
{{/js}}
